{
	"name": "@happyhackingspace/scorecard",
	"version": "0.2.0",
	"description": "Reference implementation of OSSF Scorecard in TypeScript",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"clean": "rm -rf dist"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.5",
		"tsup": "^8.3.5",
		"typescript": "^5.7.2",
		"vitest": "^5.0.3"
	},
	"packageManager": "bun@1.3.6",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/HappyHackingSpace/scorecard"
	},
	"keywords": [
		"ossf",
		"scorecard",
		"security",
		"github",
		"supply-chain"
	]
}
